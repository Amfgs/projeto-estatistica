      "metadata": {
        "id": "576dba38"
      },
      "source": [
        "### 6.2 Tabela `club_games` — estado antes do tratamento\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "f9d7d38a",
