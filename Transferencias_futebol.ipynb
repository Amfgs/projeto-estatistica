        "# Dicionário final competition_id -> nome_da_liga, construído SOMENTE após a inspeção acima.\n",
        "# Os nomes exatos em 'name' são usados para localizar a linha correta de cada país.\n",
        "def localizar_id(nome_contido, pais=None):\n",
        "    filtro = candidatos_ligas[\"name\"].str.contains(nome_contido, case=False, na=False)\n",
        "    if pais and coluna_pais:\n",
        "        filtro &= candidatos_ligas[coluna_pais] == pais\n",
        "    resultado = candidatos_ligas[filtro]\n",
        "    if len(resultado) == 0:\n",
