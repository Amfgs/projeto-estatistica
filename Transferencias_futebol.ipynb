        "    if df is None:\n",
        "        continue\n",
        "    faltando = [c for c in colunas if c not in df.columns]\n",
        "    print(f\"{nome}: colunas esperadas ausentes -> {faltando if faltando else 'nenhuma - todas presentes'}\")\n"
      ]
    },
