      "outputs": [],
      "source": [
        "def inspecionar(nome, df, n=5):\n",
        "    print(\"=\" * 80)\n",
        "    print(f\"TABELA: {nome}\")\n",
        "    print(\"=\" * 80)\n",
        "    print(\"Shape:\", df.shape)\n",
        "    print(\"\\nColunas e tipos:\")\n",
        "    print(df.dtypes)\n",
        "    print(\"\\nPrimeiras linhas:\")\n",
        "    display(df.head(n))\n",
        "    print()\n",
        "\n",
        "for nome, df in tabelas.items():\n",
        "    if df is not None:\n",
        "        inspecionar(nome, df)\n"
      ]
    },
